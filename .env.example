# Template Konfigurasi Cabang Baru Pabrik Es Kristal
BRANCH_CITY=Makassar
BRANCH_CODE=MKS-01

# Cloud Supabase PostgreSQL Sync
CLOUD_SYNC_ENABLED=true
CLOUD_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
CLOUD_SUPABASE_KEY=YOUR_SUPABASE_KEY
CLOUD_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
CLOUD_SYNC_INTERVAL_SEC=10

# Telegram Bot Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server API & Web Dashboard Security
API_SECRET_KEY=GANTI_DENGAN_STRING_ACAK_PANJANG  # python -c "import secrets;print(secrets.token_urlsafe(32))"
REQUIRE_API_KEY=true
API_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=
ALLOW_SIMULATION=false
DISABLE_API_DOCS=true
COOKIE_SECURE=false
EVIDENCE_RETENTION_DAYS=30
SNAPSHOT_RETENTION_DAYS=7
MAX_DISK_USAGE_PERCENT=85.0

